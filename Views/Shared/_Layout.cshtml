<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hastane ve Klinik Randevu Yönetim Sistemi - Online randevu alın, doktorlarınızı yönetin." />
    <title>@ViewData["Title"] — MedRandevu</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("HeadStyles", required: false)
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark med-navbar fixed-top">
        <div class="container-xl">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span class="brand-text">Med<span class="brand-accent">Randevu</span></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto ms-3 gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Hasta"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Hasta" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Hasta" asp-action="YeniRandevu">
                                    <i class="bi bi-calendar-plus me-1"></i>Yeni Randevu
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Hasta" asp-action="RandevularBenim">
                                    <i class="bi bi-calendar-check me-1"></i>Randevularım
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Doktor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Doktor" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Doktor" asp-action="Randevular">
                                    <i class="bi bi-calendar-week me-1"></i>Randevular
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Doktor" asp-action="Program">
                                    <i class="bi bi-clock-history me-1"></i>Çalışma Programı
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-custom dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-building-add me-1"></i>Kurumlar
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark border-0 shadow">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Kurumlar"><i class="bi bi-buildings me-2"></i>Kurum Listesi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="KurumEkle"><i class="bi bi-plus-circle me-2"></i>Kurum Ekle</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-custom dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-people me-1"></i>Yönetim
                                </a>

                                <ul class="dropdown-menu dropdown-menu-dark border-0 shadow">

                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Doktorlar">
                                            <i class="bi bi-person-badge me-2"></i>Doktorlar
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="DoktorEkle">
                                            <i class="bi bi-person-plus me-2"></i>Doktor Ekle
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Hastalar">
                                            <i class="bi bi-person-lines-fill me-2"></i>Hastalar
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="TumRandevular">
                                            <i class="bi bi-calendar-range me-2"></i>Tüm Randevular
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Hizmetler">
                                            <i class="bi bi-heart-pulse me-2"></i>Hizmet Yönetimi
                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }
                    }
                </ul>

                <!-- Sağ taraf -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn user-menu-btn dropdown-toggle d-flex align-items-center gap-2"
                                    data-bs-toggle="dropdown">
                                <div class="user-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="d-none d-md-inline user-name">@User.Identity.Name?.Split('@')[0]</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark border-0 shadow-lg">
                                <li>
                                    <div class="dropdown-item-text px-3 py-2">
                                        <small class="text-muted">Oturum açık</small>
                                        <div class="fw-semibold">@User.Identity.Name</div>
                                        @if (User.IsInRole("Admin"))
                                        { <span class="badge bg-danger">Yönetici</span> }
                                        else if (User.IsInRole("Doktor"))
                                        { <span class="badge bg-primary">Doktor</span> }
                                        else
                                        { <span class="badge bg-success">Hasta</span> }
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Cikis" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Giris" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Giriş
                        </a>
                        <a asp-controller="Auth" asp-action="Kayit" class="btn btn-primary btn-sm">
                            <i class="bi bi-person-plus me-1"></i>Kayıt Ol
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <!-- Alert mesajları -->
        @if (TempData["Basari"] != null)
        {
            <div class="container-xl pt-3">
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                    <span>@TempData["Basari"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="container-xl pt-3">
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                    <span>@TempData["Hata"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="med-footer mt-auto py-4">
        <div class="container-xl">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <span class="text-muted small">
                        &copy; 2024 MedRandevu — Hastane/Klinik Randevu Yönetim Sistemi
                    </span>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="text-muted small">
                        Nesneye Dayalı Programlama Projesi — C# ASP.NET Core MVC
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
