@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Ana Sayfa";
    var girisYapti = User.Identity?.IsAuthenticated == true;
    var panel = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doktor") ? "Doktor" : "Hasta";
}

<div class="container-xl">

    <!-- HERO -->
    <section class="hero-split row align-items-center g-5">
        <div class="col-lg-6">
            <span class="hero-badge"><i class="bi bi-heart-pulse-fill"></i>Hastane &amp; Klinik Randevu Sistemi</span>
            <h1 class="mt-3 mb-3">Sağlığınız için <span class="gradient-text">doğru randevu</span>, doğru zamanda</h1>
            <p class="lead text-secondary mb-4">
                Kurum, bölüm ve doktorunuzu seçin; doktorun uygun saatlerinden size en yakın olanı birkaç
                tıkla ayırtın. Çakışan randevular sistem tarafından otomatik engellenir.
            </p>

            <div class="d-flex flex-wrap gap-2">
                @if (girisYapti)
                {
                    <a asp-controller="@panel" asp-action="Dashboard" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-grid-1x2 me-2"></i>Panele Git
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Kayit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-person-plus me-2"></i>Hemen Kayıt Ol
                    </a>
                    <a asp-controller="Auth" asp-action="Giris" class="btn btn-outline-primary btn-lg px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                    </a>
                }
            </div>

            <div class="hero-points">
                <div class="hero-point"><i class="bi bi-calendar2-check"></i>Online randevu</div>
                <div class="hero-point"><i class="bi bi-shield-check"></i>Çakışma kontrolü</div>
                <div class="hero-point"><i class="bi bi-people"></i>Hasta, doktor ve yönetici rolleri</div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="mock-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-semibold"><i class="bi bi-calendar-event me-2 text-primary"></i>Randevu özeti</div>
                    <span class="badge text-bg-light border text-secondary">Örnek</span>
                </div>
                <div class="mock-row">
                    <div class="mock-icon"><i class="bi bi-hospital"></i></div>
                    <div>
                        <div class="small text-secondary">Kurum</div>
                        <div class="fw-semibold">Şehir Eğitim ve Araştırma Hastanesi</div>
                    </div>
                </div>
                <div class="mock-row">
                    <div class="mock-icon"><i class="bi bi-heart-pulse"></i></div>
                    <div>
                        <div class="small text-secondary">Bölüm</div>
                        <div class="fw-semibold">Kardiyoloji</div>
                    </div>
                </div>
                <div class="mock-row">
                    <div class="mock-icon"><i class="bi bi-person-badge"></i></div>
                    <div>
                        <div class="small text-secondary">Doktor</div>
                        <div class="fw-semibold">Prof. Dr. Ahmet Yılmaz</div>
                    </div>
                </div>
                <div class="mock-row justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="mock-icon"><i class="bi bi-clock"></i></div>
                        <div>
                            <div class="small text-secondary">Tarih ve saat</div>
                            <div class="fw-semibold">20 Kasım · 12:00</div>
                        </div>
                    </div>
                    <span class="badge text-bg-success">Onaylandı</span>
                </div>
            </div>
        </div>
    </section>

  
    <section class="py-4">
        <div class="text-center mb-4">
            <h2 class="section-title h3 mb-1">Nasıl çalışır?</h2>
            <p class="text-secondary mb-0">Dört adımda randevunuz hazır.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="med-card med-card-body h-100">
                    <div class="step-num">1</div>
                    <h3 class="h6">Kurum ve bölüm seçin</h3>
                    <p class="text-secondary small mb-0">Hastane veya klinik ile gitmek istediğiniz bölümü belirleyin.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="med-card med-card-body h-100">
                    <div class="step-num">2</div>
                    <h3 class="h6">Doktor ve hizmet seçin</h3>
                    <p class="text-secondary small mb-0">Bölümdeki doktorlar ve sundukları hizmetler arasından seçim yapın.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="med-card med-card-body h-100">
                    <div class="step-num">3</div>
                    <h3 class="h6">Uygun saati seçin</h3>
                    <p class="text-secondary small mb-0">Sadece doktorun müsait olduğu saatler listelenir.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="med-card med-card-body h-100">
                    <div class="step-num">4</div>
                    <h3 class="h6">Onayı bekleyin</h3>
                    <p class="text-secondary small mb-0">Doktor randevuyu onaylar; durumu panelinizden takip edersiniz.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ROLLER -->
    <section class="py-4">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="med-card med-card-body h-100">
                    <div class="feature-icon"><i class="bi bi-calendar-plus"></i></div>
                    <h3 class="h5">Hastalar için</h3>
                    <p class="text-secondary mb-0">Randevu alın, randevularınızı takip edin ve gerekirse iptal edin.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="med-card med-card-body h-100">
                    <div class="feature-icon"><i class="bi bi-clock-history"></i></div>
                    <h3 class="h5">Doktorlar için</h3>
                    <p class="text-secondary mb-0">Çalışma saatlerinizi tanımlayın, gelen talepleri onaylayın veya gerekçesiyle reddedin.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="med-card med-card-body h-100">
                    <div class="feature-icon"><i class="bi bi-buildings"></i></div>
                    <h3 class="h5">Yöneticiler için</h3>
                    <p class="text-secondary mb-0">Kurum, bölüm, hizmet ve doktorları yönetin; tüm randevuları tek yerden izleyin.</p>
                </div>
            </div>
        </div>
    </section>

    @if (Env.IsDevelopment() && !girisYapti)
    {
        <!-- Demo giriş bilgileri: -->
        <section class="py-3">
            <div class="demo-box">
                <div class="fw-semibold mb-2"><i class="bi bi-key me-2 text-primary"></i>Demo giriş bilgileri</div>
                <div class="row g-2 small">
                    <div class="col-md-4"><span class="text-secondary">Yönetici:</span> <code>admin@hastane.com</code> / <code>Admin123!</code></div>
                    <div class="col-md-4"><span class="text-secondary">Doktor:</span> <code>ahmet.yilmaz@hastane.com</code> / <code>Doktor123!</code></div>
                    <div class="col-md-4"><span class="text-secondary">Hasta:</span> <code>hasta@hastane.com</code> / <code>Hasta123!</code></div>
                </div>
            </div>
        </section>
    }

    @if (!girisYapti)
    {
        <section class="py-4">
            <div class="cta-band">
                <h2 class="h3 fw-bold mb-2">Randevunuzu bugün alın</h2>
                <p class="mb-4 opacity-75">Ücretsiz hesap oluşturun, dakikalar içinde ilk randevunuzu ayarlayın.</p>
                <a asp-controller="Auth" asp-action="Kayit" class="btn btn-light btn-lg px-4">
                    <i class="bi bi-person-plus me-2"></i>Kayıt Ol
                </a>
            </div>
        </section>
    }
</div>
