@model KayitViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container-xl auth-wrap">
    <div class="auth-card wide">
        <div class="med-card med-card-body p-4">
            <div class="text-center mb-4">
                <h1 class="h4 page-title mb-1">Hasta hesabı oluşturun</h1>
                <p class="text-secondary mb-0">Randevu almak için kısa bir kayıt formu</p>
            </div>

            <form asp-action="Kayit" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Ad" class="form-label"></label>
                        <input asp-for="Ad" class="form-control" />
                        <span asp-validation-for="Ad" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Soyad" class="form-label"></label>
                        <input asp-for="Soyad" class="form-control" />
                        <span asp-validation-for="Soyad" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Telefon" class="form-label"></label>
                        <input asp-for="Telefon" class="form-control" placeholder="05xx xxx xx xx" />
                        <span asp-validation-for="Telefon" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TcKimlikNo" class="form-label"></label>
                        <input asp-for="TcKimlikNo" class="form-control" maxlength="11" inputmode="numeric" />
                        <span asp-validation-for="TcKimlikNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DogumTarihi" class="form-label"></label>
                        <input asp-for="DogumTarihi" type="date" class="form-control" />
                        <span asp-validation-for="DogumTarihi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Sifre" class="form-label"></label>
                        <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                        <div class="form-text">En az 6 karakter, 1 rakam ve 1 büyük harf içermeli.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SifreTekrar" class="form-label"></label>
                        <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mt-4">
                    <i class="bi bi-person-plus me-1"></i>Kayıt Ol
                </button>
            </form>

            <p class="text-center text-secondary small mt-4 mb-0">
                Zaten hesabınız var mı? <a asp-action="Giris">Giriş yapın</a>
            </p>
        </div>
    </div>
</div>
