@model HastaneRandevu.Models.Domain.Hizmet

@{
    ViewData["Title"] = "Hizmet Düzenle";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Hizmetler"
           class="text-info text-decoration-none">
            <i class="bi bi-arrow-left"></i> Hizmet Listesine Dön
        </a>

        <h2 class="text-white fw-bold mt-3">
            <i class="bi bi-pencil-square text-info"></i>
            Hizmet Düzenle
        </h2>

        <p class="text-secondary">
            @Model.Ad hizmetinin bilgilerini güncelleyin.
        </p>
    </div>

    <div class="card bg-dark border-secondary">
        <div class="card-header border-secondary">
            <h5 class="text-white mb-0">Hizmet Bilgileri</h5>
        </div>

        <div class="card-body p-4">

            <form asp-action="HizmetDuzenle"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Ad" class="form-label text-white">
                        Hizmet Adı
                    </label>

                    <input asp-for="Ad" class="form-control" />

                    <span asp-validation-for="Ad"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Aciklama"
                           class="form-label text-white">
                        Açıklama
                    </label>

                    <textarea asp-for="Aciklama"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="Aciklama"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BolumId"
                           class="form-label text-white">
                        Bağlı Olduğu Bölüm
                    </label>

                    <select asp-for="BolumId"
                            asp-items="ViewBag.Bolumler"
                            class="form-select">
                        <option value="">Bölüm Seçiniz</option>
                    </select>

                    <span asp-validation-for="BolumId"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="SureDakika"
                               class="form-label text-white">
                            Hizmet Süresi (Dakika)
                        </label>

                        <input asp-for="SureDakika"
                               type="number"
                               min="5"
                               max="480"
                               class="form-control" />

                        <span asp-validation-for="SureDakika"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Ucret"
                               class="form-label text-white">
                            Hizmet Ücreti (₺)
                        </label>

                        <input asp-for="Ucret"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="Ucret"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="AktifMi"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="AktifMi"
                           class="form-check-label text-white">
                        Hizmet Aktif
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i>
                        Değişiklikleri Kaydet
                    </button>

                    <a asp-action="Hizmetler"
                       class="btn btn-outline-secondary">
                        Vazgeç
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
