@model IEnumerable<Doktor>
@{
    ViewData["Title"] = "Doktorlar";
}

<div class="container-xl">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="page-title h3 mb-0">Doktorlar</h1>
        <a asp-action="DoktorEkle" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Doktor Ekle</a>
    </div>

    <div class="med-card">
        @if (!Model.Any())
        {
            <div class="empty-state"><i class="bi bi-person-x"></i>Henüz doktor eklenmemiş.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-med align-middle">
                    <thead>
                        <tr>
                            <th>Doktor</th>
                            <th>Uzmanlık</th>
                            <th>Kurum / Bölüm</th>
                            <th>İletişim</th>
                            <th>Deneyim</th>
                            <th>Ücret</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@d.TamAd</td>
                                <td>@d.UzmanlikAlani</td>
                                <td>
                                    <div>@d.Kurum?.Ad</div>
                                    <div class="small text-secondary">@d.Bolum?.Ad</div>
                                </td>
                                <td>
                                    <div>@d.Email</div>
                                    <div class="small text-secondary">@d.Telefon</div>
                                </td>
                                <td>@d.DeneyimYili yıl</td>
                                <td>@d.MuayeneUcreti.ToString("N0") ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
