@model IEnumerable<Randevu>
@{
    ViewData["Title"] = "Randevular";
}

<div class="container-xl">
    <h1 class="page-title h3 mb-4">Randevular</h1>

    <div class="med-card">
        @if (!Model.Any())
        {
            <div class="empty-state"><i class="bi bi-calendar-x"></i>Henüz randevu yok.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-med align-middle">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Hasta</th>
                            <th>Hizmet</th>
                            <th>Not</th>
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.OrderByDescending(x => x.BaslangicZamani))
                        {
                            var durum = r.Durum.ToString();
                            <tr>
                                <td>
                                    <div class="fw-semibold">@r.BaslangicZamani.ToString("dd.MM.yyyy")</div>
                                    <div class="small text-secondary">@r.BaslangicZamani.ToString("HH:mm") – @r.BitisZamani.ToString("HH:mm")</div>
                                </td>
                                <td>@r.Hasta?.TamAd</td>
                                <td>@r.Hizmet?.Ad</td>
                                <td class="small text-secondary" style="max-width:220px;">@r.HastaNotlari</td>
                                <td><partial name="_DurumBadge" model="r.Durum" /></td>
                                <td class="text-end">
                                    @if (durum == "Bekliyor")
                                    {
                                        <div class="d-inline-flex gap-1">
                                            <form asp-action="Onayla" asp-route-id="@r.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg me-1"></i>Onayla
                                                </button>
                                            </form>
                                            <a asp-action="Reddet" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-lg me-1"></i>Reddet
                                            </a>
                                        </div>
                                    }
                                    else if (durum == "Onaylandi")
                                    {
                                        <form asp-action="Tamamla" asp-route-id="@r.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-clipboard2-check me-1"></i>Tamamlandı
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
